generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ModuleKey {
  POS
  KITCHEN
  PRODUCTS
  CUSTOMERS
  HR
  ROOMS
  STORE
  BAR_LOUNGE
  HOUSEKEEPING
  RESERVATIONS
  ACCOUNTING
  REPORTS
  SERVICE_CENTER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum DrinkTemperature {
  HOT
  COLD
  OTHER
}

enum RoomStatus {
  VACANT
  OCCUPIED
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum RoomCleanliness {
  CLEAN
  DIRTY
  INSPECTING
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum HousekeepingTaskType {
  CLEANING
  INSPECTION
  MAINTENANCE
}

// Every reason a product's stock at a location can change. The ledger
// (InventoryMovement) records one row per change with the signed quantity,
// the balance before/after, and a cash value — nothing edits stock without
// writing one of these.
enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE_LOSS
  ADJUSTMENT
  BORROWED_IN
  RETURNED_BORROWED_STOCK
  LENT_OUT
  LOAN_RETURNED
}

// Which part of the property a category organizes. One shared hierarchy —
// Store products use STORE, restaurant menu items use RESTAURANT, and so on
// — so a category tree isn't duplicated per module.
enum CategoryScope {
  STORE
  RESTAURANT
  BAR
  GYM
  SPA
  ROOMS
  ASSETS
}

enum PosOrderStatus {
  OPEN
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  // A cancellation the waiter requested (with a reason) that an admin has
  // not yet approved or rejected. The order is frozen while it waits.
  PENDING_CANCELLATION
}

// Money state of a POS order, kept separate from its lifecycle `status` so
// an order can be COMPLETED while still owed for (completed on credit).
enum PosPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum CustomerCreditType {
  CREDIT // an order was completed short — balance went up
  REPAYMENT // the customer paid toward their balance — it went down
  ADJUSTMENT // a manual correction
}

// Which catalog/POS screen created this order. PRODUCTS/SERVICES orders
// have no kitchen step — they're created directly as SERVED.
enum PosOrderChannel {
  FOOD
  PRODUCTS
  SERVICES
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PermissionSection {
  OVERVIEW
  RECEPTION
  HOUSEKEEPING
  SALES
  KITCHEN
  SERVICE_CENTER
  INVENTORY
  TEAM
  FINANCE
  REPORTS
  SYSTEM
}

// Fine-grained action-level capabilities, enforced server-side by
// requirePermission() — separate from PermissionSection, which only hides
// sidebar/routes client-side. Extend this list as new gated actions need
// one; a role's `permissions` array is empty by default (grants nothing).
enum Permission {
  // See every order at a location, not just ones you created yourself.
  POS_VIEW_ALL_ORDERS
  // Mark a counter-routed order as served (the counter's approval step).
  POS_APPROVE_COUNTER
  // Approve or reject a waiter's cancellation request.
  POS_APPROVE_CANCELLATION
  // Manage shift templates and employees' shift rotations/overrides.
  SHIFT_MANAGE
  // Mark/edit the daily attendance register.
  ATTENDANCE_MANAGE
  // Log in and use the system regardless of shift hours — for roles (owner,
  // manager, accountant, ...) that aren't shift workers. A Super Admin
  // already bypasses every permission check, shift enforcement included.
  SHIFT_EXEMPT
  // Raise, edit, submit, and cancel a purchase requisition (product +
  // quantity only — this role never sees or sets cost). Typically a
  // storekeeper or a counter/bar lead who notices something is running low.
  REQUISITION_CREATE
  // Approve or reject a submitted requisition (setting its estimated line
  // costs as part of that review, since the raiser never enters them) and
  // convert an approved one into a Purchase. Deliberately one permission —
  // whoever can approve is trusted to also place the order.
  REQUISITION_APPROVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

// Payroll disbursement only — how the business pays a staff member. Kept
// distinct from the customer-facing PaymentMethod model (opposite direction,
// different domain); renamed off the bare "PaymentMethod" name once that
// became the tenant-configurable model below.
enum EmployeePaymentMethod {
  BANK_TRANSFER
  MPESA
  CASH
  CHEQUE
  CARD
}

enum BusinessType {
  RESTAURANT
  CAFE
  HOTEL
  MOTEL
  CLUB
}

enum Currency {
  KES
  UGX
  TZS
  USD
}

enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

// How a supply is treated for VAT. STANDARD is taxed at a rate (per TaxMode);
// ZERO_RATED is a taxable supply charged at 0%; EXEMPT is outside VAT
// altogether. A menu item inherits the tenant's default (BusinessProfile)
// unless it sets its own.
enum TaxTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenseKey        String        @default(uuid())
  licenseStatus     LicenseStatus @default(TRIAL)
  // planId points at the shared Plan catalog row this tenant is on.
  // subscriptionPlan / maxBranches / maxUsers / maxDevices are a
  // denormalised SNAPSHOT copied from that plan at assignment time —
  // editable per tenant (deliberate override) and left untouched if the
  // plan definition later changes. License enforcement reads the snapshot,
  // never the Plan directly.
  planId            String?
  plan              Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionPlan  String        @default("Hotelier Standard — Yearly")
  subscriptionStart DateTime      @default(now())
  nextDueDate       DateTime?
  maxBranches       Int           @default(1)
  maxUsers          Int           @default(10)
  maxDevices        Int           @default(10)
  lastLicenseCheck  DateTime?

  tenantModules         TenantModule[]
  cafeSettings          CafeSettings?
  categories            Category[]
  products              Product[]
  productStocks         ProductStock[]
  inventoryMovements    InventoryMovement[]
  posOrders             PosOrder[]
  addons                Addon[]
  menuItems             MenuItem[]
  menuCategories        MenuCategory[]
  menuItemVariants      MenuItemVariant[]
  recipes               Recipe[]
  tables                Table[]
  payments              Payment[]
  locations             Location[]
  customers             Customer[]
  customerCreditEntries CustomerCreditEntry[]
  tenantSequences       TenantSequence[]
  reservationGuests     ReservationGuest[]
  folios                Folio[]
  folioLineItems        FolioLineItem[]
  folioPayments         FolioPayment[]
  rooms                 Room[]
  roomTypes             RoomType[]
  roomRates             RoomRate[]
  serviceCategories     ServiceCategory[]
  unitsOfMeasure        UnitOfMeasure[]
  services              Service[]
  reservations          Reservation[]
  housekeepingTasks     HousekeepingTask[]
  employees             Employee[]
  departments           Department[]
  businessProfile       BusinessProfile?
  roles                 Role[]
  sessions              Session[]
  paymentMethods        PaymentMethod[]
  transactions          Transaction[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  lostFoundItems        LostFoundItem[]
  reservationActivities ReservationActivity[]
  assets                Asset[]
  assetMovements        AssetMovement[]
  suppliers             Supplier[]
  purchases             Purchase[]
  purchaseRequisitions  PurchaseRequisition[]
  goodsReceipts         GoodsReceipt[]
  stockTransfers        StockTransfer[]
  supplierPayments      SupplierPayment[]
  supplierBalanceEntries SupplierBalanceEntry[]
  serviceCenterServices ServiceCenterService[]
  serviceProviders      ServiceProvider[]
  providerSchedules     ProviderSchedule[]
  membershipPlans       MembershipPlan[]
  memberships           Membership[]
  membershipPayments    MembershipPayment[]
  appointments          Appointment[]
  shiftTemplates        ShiftTemplate[]
  shiftRotations        EmployeeShiftRotation[]
  shiftOverrides        EmployeeShiftOverride[]
  attendanceRecords     AttendanceRecord[]
}

enum CustomerType {
  PERSONAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PreferredLanguage {
  ENGLISH
  SWAHILI
  OTHER
}

enum ContactMethod {
  PHYSICAL
  CALL
  WHATSAPP
  EMAIL
}

// Generic atomic per-tenant counter — one row per (tenantId, key), e.g.
// key="customer" backs Customer.customerNo, key="reservation" backs
// Reservation.reservationNo, key="folio" backs Folio.folioNo. Widened from
// the original single-purpose CustomerSequence (which used tenantId alone
// as its PK) once a second and third counter were needed.
model TenantSequence {
  id         String @id @default(cuid())
  tenantId   String
  key        String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastNumber Int    @default(0)

  @@unique([tenantId, key])
}

model Customer {
  id           String       @id @default(cuid())
  tenantId     String
  customerNo   String
  customerType CustomerType @default(PERSONAL)

  firstName String
  lastName  String?
  email     String?
  phone     String

  nationality String?
  idNumber    String? // passport / national ID number
  occupation  String?
  gender      Gender?
  dob         DateTime?

  carModel        String?
  carRegistration String?
  carColour       String?

  status  CustomerStatus @default(ACTIVE)
  address String?
  notes   String?

  // Business details — usable regardless of customerType, but primarily
  // relevant when customerType is BUSINESS.
  businessName       String?
  registrationNumber String?
  kraPin             String?
  contactPerson      String?
  billingPhone       String?
  billingEmail       String?
  website            String?

  // Personal preferences
  preferredLanguage PreferredLanguage?
  preferredCurrency Currency?
  contactMethod     ContactMethod?
  marketingConsent  Boolean            @default(false)
  loyaltyPoints     Int                @default(0)

  // Emergency contact
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Running amount the customer owes the business — raised when a POS order
  // is completed without full payment (on credit), lowered as they pay it
  // down. Every change is mirrored in CustomerCreditEntry.
  balance Decimal @default(0) @db.Decimal(12, 2)

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  locationId        String?
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations      Reservation[]
  transactions      Transaction[]
  posOrders         PosOrder[]
  creditEntries     CustomerCreditEntry[]
  createdByEmployee Employee?             @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?             @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  location          Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  memberships       Membership[]
  appointments      Appointment[]

  @@unique([tenantId, customerNo])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, status])
}

model Room {
  id                String             @id @default(cuid())
  tenantId          String
  number            String
  name              String?
  roomTypeId        String
  floor             String?
  wing              String?
  notes             String?
  capacity          Int                @default(2)
  nightlyRate       Decimal            @db.Decimal(12, 2)
  status            RoomStatus         @default(VACANT)
  cleanliness       RoomCleanliness    @default(CLEAN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  lostFoundItems    LostFoundItem[]
  createdByEmployee Employee?          @relation("RoomCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?          @relation("RoomUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([tenantId, roomTypeId])
}

enum MealPlan {
  ROOM_ONLY
  BED_AND_BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

model RoomRate {
  id                String    @id @default(cuid())
  tenantId          String
  roomTypeId        String
  mealPlan          MealPlan
  price             Decimal   @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomType          RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  createdByEmployee Employee? @relation("RoomRateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee? @relation("RoomRateUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([roomTypeId, mealPlan])
  @@index([tenantId, roomTypeId])
}

model RoomType {
  id                String     @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  capacity          Int        @default(2)
  baseRate          Decimal    @db.Decimal(12, 2)
  amenities         String[]   @default([])
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdBy         String?
  updatedBy         String?
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms             Room[]
  rates             RoomRate[]
  createdByEmployee Employee?  @relation("RoomTypeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?  @relation("RoomTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// Deliberately flat, no hierarchy — a conscious contrast to the Category
// model's parent/child/scope tree used for products/menu items.
model ServiceCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@unique([tenantId, name])
}

// A single tenant-wide lookup, used universally wherever a "per X" unit is
// needed — not scoped to Services specifically.
model UnitOfMeasure {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]
  packProducts Product[] @relation("ProductPackUnit")

  @@unique([tenantId, name])
}

model Service {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitId      String
  unit        UnitOfMeasure   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  price       Decimal         @db.Decimal(12, 2)
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // Empty = unallocated = sellable at every location (the default) —
  // identical convention to MenuItem.locations.
  locations   Location[]
  orderItems  PosOrderItem[]

  @@unique([tenantId, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, unitId])
}

model HousekeepingTask {
  id                String                 @id @default(cuid())
  tenantId          String
  roomId            String
  type              HousekeepingTaskType   @default(CLEANING)
  status            HousekeepingTaskStatus @default(PENDING)
  assignedTo        String?
  notes             String?
  dueAt             DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  createdBy         String?
  updatedBy         String?
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room              Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdByEmployee Employee?              @relation("HousekeepingTaskCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?              @relation("HousekeepingTaskUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, roomId])
}

enum LostFoundStatus {
  UNCLAIMED
  COLLECTED
}

// Recorded by whoever finds an item (usually housekeeping during turnover).
// Never hard-deleted from being collected — collection is reversible (a
// mis-click "collect" shouldn't be a dead end) — but a genuine duplicate/
// mistaken entry can still be deleted outright, since this is an
// operational log, not a financial ledger.
model LostFoundItem {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemNo              String
  itemName            String
  description         String?
  roomId              String?
  room                Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  locationNote        String?
  foundAt             DateTime        @default(now())
  foundBy             String?
  foundByEmployee     Employee?       @relation("LostFoundFoundBy", fields: [foundBy], references: [id], onDelete: SetNull)
  status              LostFoundStatus @default(UNCLAIMED)
  collectedByName     String?
  collectedByContact  String?
  collectedAt         DateTime?
  collectedBy         String?
  collectedByEmployee Employee?       @relation("LostFoundCollectedBy", fields: [collectedBy], references: [id], onDelete: SetNull)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, itemNo])
  @@index([tenantId, status])
  @@index([tenantId, roomId])
}

enum ReservationSource {
  WALK_IN
  PHONE
  WEBSITE
  BOOKING_ENGINE
  TRAVEL_AGENT
  OTA
  CORPORATE
  OTHER
}

enum CancellationReason {
  CHANGED_MIND
  NO_SHOW
  FOUND_ALTERNATIVE
  DUPLICATE_BOOKING
  HOTEL_CANCELLED
  OTHER
}

model Reservation {
  id                 String                @id @default(cuid())
  tenantId           String
  reservationNo      String
  customerId         String
  roomId             String
  source             ReservationSource     @default(WALK_IN)
  bookingDate        DateTime              @default(now())
  checkIn            DateTime
  checkOut           DateTime
  adults             Int                   @default(1)
  children           Int                   @default(0)
  mealPlan           MealPlan              @default(ROOM_ONLY)
  status             ReservationStatus     @default(PENDING)
  cancellationReason CancellationReason?
  cancellationNotes  String?
  notes              String?
  createdBy          String?
  updatedBy          String?
  locationId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  room               Room                  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdByEmployee  Employee?             @relation("ReservationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee  Employee?             @relation("ReservationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  location           Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  posOrders          PosOrder[]
  folio              Folio?
  additionalGuests   ReservationGuest[]
  activities         ReservationActivity[]

  @@unique([tenantId, reservationNo])
  @@index([tenantId, checkIn, checkOut])
  @@index([tenantId, roomId, status])
}

model ReservationGuest {
  id              String      @id @default(cuid())
  tenantId        String
  reservationId   String
  name            String
  idNumber        String?
  notes           String?
  addedAt         DateTime    @default(now())
  addedBy         String?
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  addedByEmployee Employee?   @relation(fields: [addedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, reservationId])
}

enum ReservationActivityAction {
  CREATED
  UPDATED
  CHECKED_IN
  EXTENDED
  GUEST_ADDED
  GUEST_REMOVED
  CHARGE_ADDED
  CHARGE_REMOVED
  DEPOSIT_RECORDED
  CANCELLED
  NO_SHOW
  CHECKED_OUT
}

// Append-only timeline of who did what to a reservation, and where — a
// generic updatedBy column can't answer "who checked this guest in" once a
// later action (extend, cancel) overwrites it, so each meaningful action
// gets its own permanent row instead of sharing one mutable field.
model ReservationActivity {
  id            String                    @id @default(cuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation               @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  action        ReservationActivityAction
  summary       String
  performedBy   String?
  employee      Employee?                 @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  occurredAt    DateTime                  @default(now())

  @@index([tenantId, reservationId, occurredAt])
}

enum FolioStatus {
  OPEN
  SETTLED
}

model Folio {
  id            String          @id @default(cuid())
  tenantId      String
  folioNo       String
  reservationId String          @unique
  status        FolioStatus     @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lineItems     FolioLineItem[]
  payments      FolioPayment[]

  @@unique([tenantId, folioNo])
}

enum FolioLineSource {
  ROOM
  SERVICE
  POS_ORDER
  AD_HOC
}

model FolioLineItem {
  id          String          @id @default(cuid())
  tenantId    String
  folioId     String
  source      FolioLineSource
  label       String
  amount      Decimal         @db.Decimal(12, 2)
  quantity    Int             @default(1)
  sourceRefId String?
  createdAt   DateTime        @default(now())
  createdBy   String?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio       Folio           @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([tenantId, folioId])
}

enum FolioPaymentKind {
  DEPOSIT
  SETTLEMENT
}

model FolioPayment {
  id              String           @id @default(cuid())
  tenantId        String
  folioId         String
  kind            FolioPaymentKind
  paymentMethodId String
  amount          Decimal          @db.Decimal(12, 2)
  reference       String?
  createdAt       DateTime         @default(now())
  createdBy       String?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio           Folio            @relation(fields: [folioId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([tenantId, folioId])
  @@index([tenantId, paymentMethodId])
}

// Tenant-configurable ways a customer can pay — replaces the old hardcoded
// PaymentMethod enum for every place a customer actually pays the business
// (folio deposits/checkout, POS bill settlement). System rows are seeded per
// tenant to match that former enum 1:1 so existing data keeps working, but
// can still be edited/disabled; only deletion is blocked on them.
model PaymentMethod {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  isSystem           Boolean             @default(false)
  isActive           Boolean             @default(true)
  requiresReference  Boolean             @default(false)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  folioPayments      FolioPayment[]
  posPayments        Payment[]
  transactions       Transaction[]
  expenses           Expense[]
  assetMovements     AssetMovement[]
  membershipPayments MembershipPayment[]
  appointments       Appointment[]
  supplierPayments   SupplierPayment[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

enum TransactionDirection {
  IN
  OUT
}

enum TransactionStatus {
  COMPLETE
  VOIDED
}

enum TransactionSource {
  FOLIO_DEPOSIT
  FOLIO_SETTLEMENT
  POS_SALE
  EXPENSE
  ASSET_PURCHASE
  SUPPLIER_PAYMENT
}

// A single, unified ledger of every payment actually made across the
// business, regardless of which module recorded it — the folio (deposits,
// checkout settlements) and POS (bill settlements) both write here as a
// side effect of the underlying payment, never directly.
model Transaction {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionNo   String
  direction       TransactionDirection
  source          TransactionSource
  status          TransactionStatus    @default(COMPLETE)
  amount          Decimal              @db.Decimal(12, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reference       String?
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employeeId      String?
  employee        Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  description     String?
  sourceRefId     String?
  createdAt       DateTime             @default(now())

  @@unique([tenantId, transactionNo])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentMethodId])
}

// Deliberately flat, no hierarchy — same shape as ServiceCategory — since
// expense categories can't be predicted upfront and need full CRUD.
model ExpenseCategory {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]

  @@unique([tenantId, name])
}

enum ExpenseStatus {
  ACTIVE
  ARCHIVED
}

// Day-to-day incidental spending (tape, fare, a replacement part) recorded
// by staff — never hard-deleted, only archived, matching the append-only
// discipline already used for Reservation/Folio records. Each one also
// writes an OUT-direction Transaction so it shows up in the same ledger as
// money coming in.
model Expense {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseNo         String
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenseDate       DateTime        @default(now())
  amount            Decimal         @db.Decimal(12, 2)
  paymentMethodId   String
  paymentMethod     PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  reference         String?
  description       String?
  locationId        String?
  location          Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status            ExpenseStatus   @default(ACTIVE)
  createdBy         String?
  createdByEmployee Employee?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([tenantId, expenseNo])
  @@index([tenantId, categoryId])
  @@index([tenantId, expenseDate])
}

enum AssetMovementType {
  RECEIPT
  ADJUSTMENT
  WRITE_OFF
}

// Durable, owned equipment (chairs, plates, cutlery) — distinct from Product
// because it's never sold or consumed, just counted and occasionally
// written off. One row per distinct item, not per physical unit; quantity
// only ever changes through an AssetMovement, never a direct edit, mirroring
// how Product's stock is never PATCHed directly either.
model Asset {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetNo           String
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  description       String?
  unit              String          @default("Each")
  quantity          Decimal         @default(0) @db.Decimal(12, 3)
  unitCost          Decimal?        @db.Decimal(12, 2)
  locationId        String?
  location          Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive          Boolean         @default(true)
  notes             String?
  createdBy         String?
  createdByEmployee Employee?       @relation("AssetCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy         String?
  updatedByEmployee Employee?       @relation("AssetUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         AssetMovement[]

  @@unique([tenantId, assetNo])
  @@index([tenantId, categoryId])
  @@index([tenantId, locationId])
}

// The financial/audit trail for an Asset — mirrors InventoryMovement's role
// for Product. Only a RECEIPT with a real cost writes a paymentMethodId and
// a matching ledger Transaction; ADJUSTMENT/WRITE_OFF just correct the count.
model AssetMovement {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type            AssetMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  unitCost        Decimal?          @db.Decimal(12, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reference       String?
  note            String?
  performedBy     String?
  employee        Employee?         @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  occurredAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())

  @@index([tenantId, assetId, occurredAt])
}

// A supplier/vendor the property buys stock from. A plain definitional
// record for now — Purchases / Goods Received will reference it later.
// Carries createdBy/updatedBy from day one, per the audit-trail precedent
// set by Asset.
model Supplier {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  city              String?
  taxPin            String?
  paymentTerms      String?
  notes             String?
  // Running account balance with this supplier — what the property owes
  // them (positive) or has in credit (negative). Goods Received only ever
  // increases it; SupplierPayment (below) is the only thing that decreases
  // it — that asymmetry is intentional, it's an accounts-payable balance.
  balance           Decimal               @default(0) @db.Decimal(12, 2)
  isActive          Boolean               @default(true)
  createdBy         String?
  createdByEmployee Employee?             @relation("SupplierCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy         String?
  updatedByEmployee Employee?             @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  purchases         Purchase[]
  requisitions      PurchaseRequisition[]
  payments          SupplierPayment[]
  balanceEntries    SupplierBalanceEntry[]
  transactions      Transaction[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// A real cash payment made TO a supplier — the only thing that ever
// decreases Supplier.balance (GoodsReceipt only ever increases it). Mirrors
// Expense: created once, writes a Transaction as a side effect, never
// edited or deleted — corrections are a new payment, not a rewrite.
model SupplierPayment {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentNo         String
  supplierId        String
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseId        String?
  purchase          Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  amount            Decimal        @db.Decimal(12, 2)
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reference         String?
  note              String?
  paidAt            DateTime       @default(now())
  createdBy         String?
  createdByEmployee Employee?      @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  balanceEntries    SupplierBalanceEntry[]

  @@unique([tenantId, paymentNo])
  @@index([tenantId, supplierId])
  @@index([tenantId, paidAt])
  @@index([purchaseId])
}

enum SupplierBalanceEntryType {
  OPENING_BALANCE
  GOODS_RECEIPT
  PAYMENT
  ADJUSTMENT
}

model SupplierBalanceEntry {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type              SupplierBalanceEntryType
  amount            Decimal                  @db.Decimal(12, 2)
  balanceBefore     Decimal                  @db.Decimal(12, 2)
  balanceAfter      Decimal                  @db.Decimal(12, 2)
  note              String?
  purchaseId        String?
  purchase          Purchase?                @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  goodsReceiptId    String?
  goodsReceipt      GoodsReceipt?            @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  paymentId         String?
  payment           SupplierPayment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy         String?
  createdByEmployee Employee?                @relation("SupplierBalanceEntryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())

  @@index([tenantId, supplierId, createdAt])
  @@index([purchaseId])
  @@index([goodsReceiptId])
  @@index([paymentId])
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

// A storekeeper's request to buy a set of items — the document that kicks
// off procurement, before any supplier is committed. Lifecycle: DRAFT ->
// SUBMITTED -> APPROVED/REJECTED by an accountant -> CONVERTED once a
// Purchase (PO) is raised from it. Estimated costs only; the real prices
// land on the Purchase. Line items must reference catalog Products.
model PurchaseRequisition {
  id                  String                    @id @default(cuid())
  tenantId            String
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requisitionNo       String
  status              PurchaseRequisitionStatus @default(DRAFT)
  requisitionDate     DateTime                  @default(now())
  neededBy            DateTime?
  purpose             String?
  notes               String?
  // A non-binding hint for whoever raises the eventual PO.
  suggestedSupplierId String?
  suggestedSupplier   Supplier?                 @relation(fields: [suggestedSupplierId], references: [id], onDelete: SetNull)
  estimatedTotal      Decimal                   @default(0) @db.Decimal(12, 2)
  submittedAt         DateTime?
  reviewedBy          String?
  reviewedByEmployee  Employee?                 @relation("RequisitionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  reviewNote          String?
  createdBy           String?
  createdByEmployee   Employee?                 @relation("RequisitionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy           String?
  updatedByEmployee   Employee?                 @relation("RequisitionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  items               PurchaseRequisitionItem[]
  purchase            Purchase?

  @@unique([tenantId, requisitionNo])
  @@index([tenantId, status])
  @@index([tenantId, requisitionDate])
}

model PurchaseRequisitionItem {
  id                String              @id @default(cuid())
  requisitionId     String
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Decimal             @db.Decimal(12, 3)
  estimatedUnitCost Decimal             @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal             @default(0) @db.Decimal(12, 2)
  note              String?
  createdAt         DateTime            @default(now())

  @@index([requisitionId])
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  // Some, but not all, ordered quantity has been received via a GoodsReceipt.
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// A purchase order raised against one supplier. Totals are a snapshot
// recomputed from the line items on every write: subtotal = sum(lineTotal),
// taxAmount = subtotal * taxRate/100, total = subtotal + taxAmount. Line
// items must reference catalog Products. Stock only moves, and the supplier
// balance only grows, when a GoodsReceipt is posted against this PO — see
// that model. locationId is where goods land by default; a receipt can still
// pick a different location for a split delivery.
model Purchase {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseNo        String
  supplierId        String
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  locationId        String?
  location          Location?            @relation("PurchaseLocation", fields: [locationId], references: [id], onDelete: SetNull)
  status            PurchaseStatus       @default(DRAFT)
  paymentStatus     PosPaymentStatus     @default(UNPAID)
  orderDate         DateTime             @default(now())
  expectedDate      DateTime?
  reference         String?
  notes             String?
  taxRate           Decimal              @default(0) @db.Decimal(5, 2)
  subtotal          Decimal              @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal              @default(0) @db.Decimal(12, 2)
  total             Decimal              @default(0) @db.Decimal(12, 2)
  // Set when this PO was created by converting an approved requisition.
  requisitionId     String?              @unique
  requisition       PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  orderedAt         DateTime?
  receivedAt        DateTime?
  createdBy         String?
  createdByEmployee Employee?            @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy         String?
  updatedByEmployee Employee?            @relation("PurchaseUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             PurchaseItem[]
  goodsReceipts     GoodsReceipt[]
  payments          SupplierPayment[]
  supplierBalanceEntries SupplierBalanceEntry[]

  @@unique([tenantId, purchaseNo])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, orderDate])
}

model PurchaseItem {
  id                String             @id @default(cuid())
  purchaseId        String
  purchase          Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Decimal            @db.Decimal(12, 3)
  unitCost          Decimal            @default(0) @db.Decimal(12, 2)
  sellingPrice      Decimal?           @db.Decimal(12, 2)
  discountPerUnit   Decimal            @default(0) @db.Decimal(12, 2)
  taxRate           Decimal            @default(0) @db.Decimal(5, 2)
  taxMode           TaxMode            @default(INCLUSIVE)
  taxTreatment      TaxTreatment       @default(STANDARD)
  taxAmount         Decimal            @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal            @default(0) @db.Decimal(12, 2)
  // Running total actually received via GoodsReceiptItem rows against this
  // line — drives the PO's PARTIALLY_RECEIVED/RECEIVED status.
  receivedQuantity  Decimal            @default(0) @db.Decimal(12, 3)
  note              String?
  createdAt         DateTime           @default(now())
  goodsReceiptItems GoodsReceiptItem[]
  menuPriceUpdates  PurchaseItemMenuPriceUpdate[]

  @@index([purchaseId])
}

model PurchaseItemMenuPriceUpdate {
  id             String       @id @default(cuid())
  purchaseItemId String
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sellingPrice   Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@unique([purchaseItemId, menuItemId])
  @@index([menuItemId])
}

// One delivery event against a PO. A PO can be received in several batches
// (part today, the rest next week) — each GoodsReceipt is one of those
// batches. Posting one moves real stock: every line here writes a PURCHASE
// InventoryMovement into `location`'s ProductStock (via recordStockMovement,
// the one choke point — nothing here writes stock directly) and bumps the
// matching PurchaseItem.receivedQuantity + the supplier's balance. Immutable
// once created, same as the ledger it feeds — correcting a bad receipt is a
// new adjustment, not an edit.
model GoodsReceipt {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNo         String
  purchaseId        String
  purchase          Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedAt        DateTime           @default(now())
  note              String?
  createdBy         String?
  createdByEmployee Employee?          @relation("GoodsReceiptCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  items             GoodsReceiptItem[]
  supplierBalanceEntries SupplierBalanceEntry[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, purchaseId])
  @@index([tenantId, locationId])
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(12, 3)
  unitCost       Decimal      @default(0) @db.Decimal(12, 2)
  note           String?

  @@index([goodsReceiptId])
}

// An internal move of stock from one location to another (warehouse to a
// selling point, or between two selling points) — no supplier, no cost,
// nothing owed. Each line freezes the balance at both ends the instant it
// was recorded (fromQtyBefore/After, toQtyBefore/After), straight from what
// recordStockMovement() returns — so the printed receipt always shows what
// was true then, even after later movements change the live balance.
model StockTransfer {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferNo        String
  fromLocationId    String
  fromLocation      Location            @relation("StockTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId      String
  toLocation        Location            @relation("StockTransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  note              String?
  createdBy         String?
  createdByEmployee Employee?           @relation("StockTransferCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  items             StockTransferItem[]

  @@unique([tenantId, transferNo])
  @@index([tenantId, fromLocationId])
  @@index([tenantId, toLocationId])
}

model StockTransferItem {
  id            String        @id @default(cuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Decimal       @db.Decimal(12, 3)
  fromQtyBefore Decimal       @db.Decimal(12, 3)
  fromQtyAfter  Decimal       @db.Decimal(12, 3)
  toQtyBefore   Decimal       @db.Decimal(12, 3)
  toQtyAfter    Decimal       @db.Decimal(12, 3)

  @@index([transferId])
}

model CafeSettings {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  cafeName         String
  currency         String   @default("KES")
  inventoryEnabled Boolean  @default(true)
  lowStockAlerts   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Up to 3 levels deep (parent -> child -> grandchild), enforced in the route
// layer. Self-referential; onDelete: Cascade so removing a category also
// removes its descendants (products under it are only SetNull, never deleted).
model Category {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope       CategoryScope @default(STORE)
  name        String
  description String?
  parentId    String?
  parent      Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]    @relation("CategoryHierarchy")
  level       Int           @default(1)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]
  menuItems   MenuItem[]
  assets      Asset[]

  @@unique([tenantId, scope, parentId, name])
  @@index([tenantId, scope, parentId])
}

model Product {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Identity
  name        String
  sku         String?
  barcode     String?
  brand       String?
  description String?
  photoUrl    String?

  // Classification
  unit          String  @default("each")
  isPerishable  Boolean @default(false)
  shelfLifeDays Int?

  // Pack / container tracking (bar bottles, kegs, cases). When packSize +
  // packUnitId are set the product's stock, recipe quantities and POS
  // deductions are all held in packUnit (e.g. ml); the number of whole
  // packs shown in the UI is just quantity / packSize. packLabel is the
  // noun for one pack ("bottle", "can", "keg"). Left blank for products
  // that are simply counted (each / kg).
  packSize   Decimal?       @db.Decimal(12, 3)
  packUnitId String?
  packUnit   UnitOfMeasure? @relation("ProductPackUnit", fields: [packUnitId], references: [id], onDelete: SetNull)
  packLabel  String?

  // Stock lives per-location (see ProductStock) — a product carries no
  // quantity of its own. reorderLevel/maxStockLevel stay tenant-wide
  // defaults for now; nothing needs them to vary per location yet.
  reorderLevel  Decimal  @default(0) @db.Decimal(12, 3)
  maxStockLevel Decimal? @db.Decimal(12, 3)

  // Costing (inventory valuation — not a selling price)
  unitCost          Decimal? @db.Decimal(12, 2)
  preferredSupplier String?

  // Null means this product is never sold directly (e.g. a recipe
  // ingredient only) — the Products POS only lists products with one set.
  sellingPrice Decimal? @db.Decimal(12, 2)

  // Tax defaults for direct product sales.
  taxRate      Decimal?     @db.Decimal(5, 2)
  taxMode      TaxMode?
  taxTreatment TaxTreatment?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems         MenuItem[]
  variantStocks     MenuItemVariant[]         @relation("VariantStock")
  addonStocks       Addon[]                   @relation("AddonStock")
  movements         InventoryMovement[]
  recipeIngredients RecipeIngredient[]
  stocks            ProductStock[]
  orderItems        PosOrderItem[]
  purchaseItems     PurchaseItem[]
  requisitionItems  PurchaseRequisitionItem[]
  goodsReceiptItems GoodsReceiptItem[]
  stockTransferItems StockTransferItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, categoryId])
}

// One live running balance per (product, location) — a location "carries"
// a product iff a row exists for that pair. Replaces the old hardcoded
// storeQuantity/kitchenQuantity split so stock can live at any tenant-
// created location (warehouse or selling point) instead of exactly two.
model ProductStock {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, productId, locationId])
  @@index([tenantId, locationId])
}

// The stock ledger: one immutable row per change to a product's balance at
// one location. `quantity` is signed (+ in, - out); `balanceBefore` +
// `quantity` = `balanceAfter` for that (product, location). `value` is the
// cash worth of the movement. Pack-tracked products convert stock units back
// to whole-pack equivalents before applying unitCost. Written only via
// recordStockMovement().
model InventoryMovement {
  id            String            @id @default(cuid())
  tenantId      String
  productId     String
  locationId    String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  balanceBefore Decimal?          @db.Decimal(12, 3)
  balanceAfter  Decimal?          @db.Decimal(12, 3)
  unitCost      Decimal?          @db.Decimal(12, 2)
  value         Decimal?          @db.Decimal(12, 2)
  note          String?
  // Where this movement came from — e.g. POS_ORDER, TRANSFER, GOODS_RECEIVED,
  // PRODUCT_OPENING, MANUAL — plus the id of that source row when there is one.
  sourceType    String?
  sourceRefId   String?
  performedBy   String?
  employee      Employee?         @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  occurredAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, locationId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

enum LocationType {
  RECEPTION
  RESTAURANT
  CAFE
  BAKERY
  BAR
  GYM
  SPA
  STORE
  SHOP
  HOUSEKEEPING
}

enum OrderServeMode {
  KITCHEN
  COUNTER
  DIRECT
}

// A physical selling point within the property — Restaurant, Bakery, Bar,
// Gym, Spa, Reception, etc. A tenant that never creates one behaves exactly
// as a single-location property (menu items are unfiltered, staff can sell
// anywhere) — this whole feature is opt-in and backward compatible. Only
// name is required; everything else here just makes a location easier to
// identify and reach, not something the POS logic depends on.
model Location {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  type                  LocationType
  description           String?
  address               String?
  managerId             String?
  manager               Employee?             @relation("LocationManager", fields: [managerId], references: [id], onDelete: SetNull)
  primaryPhone          String?
  secondaryPhone        String?
  email                 String?
  // Stored as "HH:MM" (24h) — a daily recurring time, not a specific date.
  openingTime           String?
  closingTime           String?
  isActive              Boolean               @default(true)
  // Selling permissions — which sale categories this location's POS shows.
  // Default true across the board so every existing location keeps behaving
  // exactly as it does today until someone deliberately unchecks one.
  canSellRooms          Boolean               @default(true)
  canSellMenu           Boolean               @default(true)
  canSellServices       Boolean               @default(true)
  canSellProducts       Boolean               @default(true)
  // How a FOOD-channel order at this location gets to SERVED:
  //  KITCHEN — full ticket (OPEN -> PREPARING -> READY), a waiter serves it.
  //  COUNTER — no kitchen prep, but a human still has to hand it over: the
  //    order is born straight at READY, and only staff with the
  //    POS_APPROVE_COUNTER permission can mark it SERVED — for a bar/club
  //    where waiters take orders on the floor but a fixed counter fulfils
  //    them, and who staffs that counter changes day to day.
  //  DIRECT — served the instant it's rung up, no human confirmation step
  //    (a bakery/café counter that hands the item over on the spot).
  serveMode             OrderServeMode        @default(KITCHEN)
  // Free-text blocks a document can print above/below its body, specific to
  // this location (e.g. a branch's own thank-you note or return policy).
  // Null means "use nothing" — the document falls back to its own default.
  receiptHeader         String?               @db.Text
  receiptFooter         String?               @db.Text
  invoiceHeader         String?               @db.Text
  invoiceFooter         String?               @db.Text
  quotationHeader       String?               @db.Text
  quotationFooter       String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  menuItems             MenuItem[]
  employees             Employee[]            @relation("LocationStaff")
  defaultForEmployees   Employee[]            @relation("EmployeeDefaultLocation")
  orders                PosOrder[]
  transactions          Transaction[]
  expenses              Expense[]
  productStocks         ProductStock[]
  inventoryMovements    InventoryMovement[]
  services              Service[]
  reservations          Reservation[]
  customers             Customer[]
  reservationActivities ReservationActivity[]
  assets                Asset[]
  tables                Table[]
  purchases             Purchase[]          @relation("PurchaseLocation")
  goodsReceipts         GoodsReceipt[]
  stockTransfersFrom    StockTransfer[]     @relation("StockTransferFrom")
  stockTransfersTo      StockTransfer[]     @relation("StockTransferTo")

  @@unique([tenantId, name])
}

// The Menu module's own category table (Menu ▸ Categories). Replaces the
// generic Category(scope=RESTAURANT) for menu use — richer (image, explicit
// sort order) and not tangled into the 3-level Category hierarchy. Existing
// RESTAURANT categories are copied in on migration; MenuItem is repointed
// here in a later phase.
model MenuCategory {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]
  addons      Addon[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, sortOrder])
}

model MenuItem {
  id              String            @id @default(cuid())
  tenantId        String
  // Legacy link to the generic Category tree — nullable now, kept only so
  // the old Menu & Add-ons screen keeps working. menuCategoryId is the real
  // one going forward.
  categoryId      String?
  menuCategoryId  String
  // Stock deduction for this item. Either productId (a single product, of
  // which each sale consumes stockQtyPerUnit — e.g. 500 for a bottled beer)
  // or recipeId (multi-ingredient, quantities on RecipeIngredient). Both
  // null = the item consumes no tracked stock. Variants can override with
  // their own product + quantity (see MenuItemVariant).
  productId       String?
  recipeId        String?
  stockQtyPerUnit Decimal?          @db.Decimal(12, 3)
  name            String
  shortName       String?
  sku             String?
  description     String?
  photoUrl        String?
  price           Decimal           @db.Decimal(12, 2)
  // Per-item tax override. All null = inherit the tenant's BusinessProfile
  // default (rate + mode + treatment). Any set value wins for that facet.
  taxRate         Decimal?          @db.Decimal(5, 2)
  taxMode         TaxMode?
  taxTreatment    TaxTreatment?
  temperature     DrinkTemperature  @default(OTHER)
  isVegetarian    Boolean           @default(false)
  // When false the POS adds this item straight to the order — no add-on
  // prompt. Turn on only for items that genuinely take extras (a burger,
  // not a latte). Variants still prompt regardless.
  allowsAddons    Boolean           @default(false)
  // Two separate concepts: isActive = in the menu at all; isAvailable =
  // currently sellable (e.g. temporarily sold out).
  isActive        Boolean           @default(true)
  isAvailable     Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  menuCategory    MenuCategory      @relation(fields: [menuCategoryId], references: [id], onDelete: Restrict)
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipe          Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  orderItems      PosOrderItem[]
  variants        MenuItemVariant[]
  purchasePriceUpdates PurchaseItemMenuPriceUpdate[]
  // Empty = unallocated = sellable at every location (the default).
  locations       Location[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, menuCategoryId, sortOrder])
  @@index([tenantId, recipeId])
}

// A sized/optioned version of a menu item with its own price — Pizza:
// Small/Medium/Large, Cappuccino: Regular/Large. NOT an add-on. An item has
// zero or many; with none, the item's base price is used, otherwise each
// variant carries its own price.
model MenuItemVariant {
  id              String         @id @default(cuid())
  tenantId        String
  menuItemId      String
  name            String
  sku             String?
  price           Decimal        @db.Decimal(12, 2)
  // Optional per-variant stock deduction. When stockProductId is set,
  // selling this variant consumes stockQtyPerUnit (in the product's pack
  // unit) of that product, INSTEAD of the parent item's product/recipe —
  // this is how "House Whisky" has Tot (25), Double (50) and Bottle (750)
  // variants all drawing from the same bottle stock.
  stockProductId  String?
  stockProduct    Product?       @relation("VariantStock", fields: [stockProductId], references: [id], onDelete: SetNull)
  stockQtyPerUnit Decimal?       @db.Decimal(12, 3)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem        MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems      PosOrderItem[]

  @@unique([tenantId, menuItemId, name])
  @@unique([tenantId, sku])
  @@index([tenantId, menuItemId, sortOrder])
}

model PosOrder {
  id                 String                @id @default(cuid())
  tenantId           String
  reservationId      String?
  // Who this order is actually for — independent of tableId (which is just
  // informational: how many people are at that table) and independent of
  // whether/how it eventually gets paid. Set at creation when known, or
  // derived from the reservation's own guest if billed to a room at
  // settlement time.
  customerId         String?
  tableId            String?
  locationId         String?
  // The employee who rang this order up. Plain id, no relation — same
  // convention as cancelRequestedBy/cancelDecidedBy below — so a waiter's
  // order list can be scoped to their own (GET /orders restricts to
  // createdBy unless the caller holds POS_VIEW_ALL_ORDERS or an approval
  // capability). Null on anything created before this field existed.
  createdBy          String?
  orderNumber        Int
  status             PosOrderStatus        @default(OPEN)
  channel            PosOrderChannel       @default(FOOD)
  discount           Decimal               @default(0) @db.Decimal(12, 2)
  notes              String?
  readyAt            DateTime?
  servedAt           DateTime?
  // Cancellation approval trail. A cancel request records the reason, who
  // asked, and the status to fall back to if an admin rejects it; the
  // decision fields are filled when an admin approves or rejects.
  cancelReason       String?
  cancelRequestedBy  String?
  cancelRequestedAt  DateTime?
  cancelDecidedBy    String?
  cancelDecidedAt    DateTime?
  cancelDecisionNote String?
  statusBeforeCancel PosOrderStatus?
  // Money state, kept apart from `status`: an order can be COMPLETED and
  // still UNPAID/PARTIAL when finished on credit.
  paymentStatus      PosPaymentStatus      @default(UNPAID)
  // Opaque token for a public, no-auth receipt page. Minted on first Share,
  // reused thereafter. Globally unique so the public route needs no tenant.
  shareToken         String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation        Reservation?          @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table              Table?                @relation(fields: [tableId], references: [id], onDelete: SetNull)
  location           Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items              PosOrderItem[]
  payments           Payment[]
  creditEntries      CustomerCreditEntry[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([reservationId])
  @@index([tableId])
  @@index([locationId])
  @@index([customerId])
}

// One row per movement of a customer's balance: +ve raises it (an order
// completed on credit), -ve lowers it (a repayment). `balanceAfter` is the
// running balance right after this entry, so a statement doesn't have to
// re-sum from zero.
model CustomerCreditEntry {
  id           String             @id @default(cuid())
  tenantId     String
  customerId   String
  orderId      String?
  type         CustomerCreditType @default(CREDIT)
  amount       Decimal            @db.Decimal(12, 2)
  balanceAfter Decimal            @db.Decimal(12, 2)
  note         String?
  createdBy    String?
  createdAt    DateTime           @default(now())
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        PosOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, createdAt])
  @@index([orderId])
}

enum PlanBillingType {
  // Recurring monthly subscription — uses monthlyPrice.
  MONTHLY
  // One-off purchase (uses oneTimePrice) plus an annualMaintenanceFee
  // billed yearly thereafter.
  ONE_TIME
}

// The shared subscription catalog TANZ staff maintain in the platform admin
// app. Platform-level — no tenantId. A Tenant references exactly one Plan
// (Tenant.planId) and copies its limits into a local snapshot on
// assignment; see the comment on Tenant.planId.
model Plan {
  id                   String          @id @default(cuid())
  name                 String          @unique
  billingType          PlanBillingType @default(MONTHLY)
  currency             Currency        @default(KES)
  monthlyPrice         Decimal         @default(0) @db.Decimal(12, 2)
  oneTimePrice         Decimal         @default(0) @db.Decimal(12, 2)
  annualMaintenanceFee Decimal         @default(0) @db.Decimal(12, 2)
  supportLevel         String?
  maxBranches          Int             @default(1)
  maxUsers             Int             @default(10)
  maxDevices           Int             @default(10)
  description          String?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  tenants              Tenant[]
}

// A physical seating spot in the restaurant/bar. One active (non-final)
// order per table at a time — the table frees back to AVAILABLE once that
// order is fully paid or cancelled.
model Table {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String
  area       String?
  capacity   Int         @default(2)
  status     TableStatus @default(AVAILABLE)
  isActive   Boolean     @default(true)
  // Which selling point this physical table belongs to — null means shared/
  // unallocated (visible everywhere), the same convention as MenuItem/Service
  // locations. Lets a Bar's table picker show only its own tables instead of
  // every table tenant-wide.
  locationId String?
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders     PosOrder[]

  @@unique([tenantId, label])
  @@index([tenantId, locationId])
}

// A single settlement against an order. Multiple payments per order support
// split bills (e.g. part cash, part M-Pesa).
model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  orderId         String
  paymentMethodId String
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  receivedBy      String?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           PosOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, paymentMethodId])
}

// One of menuItemId/productId/serviceId is set, matching the parent order's
// channel (enforced at the API layer, same convention as FolioLineItem.source
// — no DB-level CHECK constraint for it either).
model PosOrderItem {
  id           String              @id @default(cuid())
  orderId      String
  menuItemId   String?
  // The specific size/option chosen for this line, when the menu item has
  // variants (Pizza: Large). Null = base item, no variants. unitPrice is
  // always the price actually charged — the variant's when set, else the
  // item's base price.
  variantId    String?
  productId    String?
  serviceId    String?
  quantity     Int                 @default(1)
  unitPrice    Decimal             @db.Decimal(12, 2)
  // Tax as resolved at the moment of sale — item override else the tenant
  // default. Snapshotted so a later change to either never re-taxes a
  // historical order. Null on pre-existing rows: callers fall back to the
  // current BusinessProfile.
  taxRate      Decimal?            @db.Decimal(5, 2)
  taxMode      TaxMode?
  taxTreatment TaxTreatment?
  createdAt    DateTime            @default(now())
  order        PosOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  variant      MenuItemVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  service      Service?            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  addons       PosOrderItemAddon[]

  @@index([orderId])
  @@index([variantId])
}

// A single add-on (Cheddar, Bacon, Extra Espresso). A flat, tenant-wide
// catalog scoped only by an optional menu category — the POS add-on picker
// filters on it (defaulting to the menu item's own category), otherwise
// shows everything. No per-item links, no groups, no selection rules.
model Addon {
  id             String              @id @default(cuid())
  tenantId       String
  menuCategoryId String?
  name           String
  description    String?
  price          Decimal             @db.Decimal(12, 2)
  sku            String?
  imageUrl       String?
  // Optional stock link, same convention as MenuItemVariant's own
  // stockProductId/stockQtyPerUnit: when set, one unit of this add-on
  // consumes stockQtyPerUnit (in the product's pack unit) of that product —
  // e.g. an "Extra Red Bull" add-on consuming 1 can, or a "Double shot"
  // add-on consuming 25ml of the same spirit as its parent variant. Without
  // this link an add-on has no stock impact at all (a free garnish, a
  // service charge line, etc.).
  stockProductId  String?
  stockProduct    Product?            @relation("AddonStock", fields: [stockProductId], references: [id], onDelete: SetNull)
  stockQtyPerUnit Decimal?            @db.Decimal(12, 3)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuCategory   MenuCategory?       @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  orderItems     PosOrderItemAddon[]

  @@unique([tenantId, name])
  @@unique([tenantId, sku])
  @@index([tenantId, menuCategoryId])
}

model PosOrderItemAddon {
  id          String       @id @default(cuid())
  orderItemId String
  addonId     String
  quantity    Int          @default(1)
  unitPrice   Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       Addon        @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
}

// A recipe is how a chef makes a dish: ordered prep steps, an estimated
// prep time, and how much of each product it consumes. It's created
// standalone in the Kitchen section, then optionally attached to one or
// more MenuItems (e.g. a "small" and "large" size sharing one recipe).
model Recipe {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  steps            String[]           @default([])
  estimatedMinutes Int?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ingredients      RecipeIngredient[]
  menuItems        MenuItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String
  productId String
  quantity  Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([recipeId, productId])
  @@index([productId])
}

model Module {
  key           ModuleKey      @id
  name          String
  description   String?
  tenantModules TenantModule[]
}

model TenantModule {
  id        String    @id @default(cuid())
  tenantId  String
  moduleKey ModuleKey
  isEnabled Boolean   @default(true)
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module    @relation(fields: [moduleKey], references: [key])

  @@unique([tenantId, moduleKey])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  employeeId String
  tenantId   String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([tenantId])
}

model Employee {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Personal info
  firstName   String
  lastName    String
  gender      Gender?
  dateOfBirth DateTime?
  nationalId  String?
  photoUrl    String?

  // Contact
  phone            String
  alternativePhone String?
  email            String?
  address          String?

  // Employment
  departmentId             String
  department               Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle                 String
  employmentType           EmploymentType        @default(FULL_TIME)
  status                   EmployeeStatus        @default(ACTIVE)
  dateHired                DateTime
  supervisorId             String?
  supervisor               Employee?             @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports                  Employee[]            @relation("EmployeeSupervisor")
  roleId                   String?
  role                     Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  // Selling/working locations this employee is pinned to. Empty = no
  // restriction (can work at any location; the POS asks which each time);
  // one or more restricts them to that set.
  locations                Location[]            @relation("LocationStaff")
  // The location the POS pre-selects for this employee — one of `locations`,
  // or null. A single-location employee's is locked to it; a multi-location
  // one starts here and can switch on the fly (which updates this).
  defaultLocationId        String?
  defaultLocation          Location?             @relation("EmployeeDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  managedLocations         Location[]            @relation("LocationManager")
  sessions                 Session[]
  createdReservations      Reservation[]         @relation("ReservationCreatedBy")
  updatedReservations      Reservation[]         @relation("ReservationUpdatedBy")
  reservationActivities    ReservationActivity[]
  addedReservationGuests   ReservationGuest[]
  transactions             Transaction[]
  expenses                 Expense[]
  foundLostItems           LostFoundItem[]       @relation("LostFoundFoundBy")
  collectedLostItems       LostFoundItem[]       @relation("LostFoundCollectedBy")
  createdCustomers         Customer[]            @relation("CustomerCreatedBy")
  updatedCustomers         Customer[]            @relation("CustomerUpdatedBy")
  createdRooms             Room[]                @relation("RoomCreatedBy")
  updatedRooms             Room[]                @relation("RoomUpdatedBy")
  createdRoomTypes         RoomType[]            @relation("RoomTypeCreatedBy")
  updatedRoomTypes         RoomType[]            @relation("RoomTypeUpdatedBy")
  createdRoomRates         RoomRate[]            @relation("RoomRateCreatedBy")
  updatedRoomRates         RoomRate[]            @relation("RoomRateUpdatedBy")
  createdHousekeepingTasks HousekeepingTask[]    @relation("HousekeepingTaskCreatedBy")
  updatedHousekeepingTasks HousekeepingTask[]    @relation("HousekeepingTaskUpdatedBy")
  createdAssets            Asset[]               @relation("AssetCreatedBy")
  updatedAssets            Asset[]               @relation("AssetUpdatedBy")
  assetMovements           AssetMovement[]
  createdSuppliers         Supplier[]            @relation("SupplierCreatedBy")
  updatedSuppliers         Supplier[]            @relation("SupplierUpdatedBy")
  createdPurchases         Purchase[]            @relation("PurchaseCreatedBy")
  updatedPurchases         Purchase[]            @relation("PurchaseUpdatedBy")
  createdGoodsReceipts     GoodsReceipt[]        @relation("GoodsReceiptCreatedBy")
  createdStockTransfers    StockTransfer[]       @relation("StockTransferCreatedBy")
  createdSupplierPayments  SupplierPayment[]     @relation("SupplierPaymentCreatedBy")
  createdSupplierBalanceEntries SupplierBalanceEntry[] @relation("SupplierBalanceEntryCreatedBy")
  createdRequisitions      PurchaseRequisition[] @relation("RequisitionCreatedBy")
  updatedRequisitions      PurchaseRequisition[] @relation("RequisitionUpdatedBy")
  reviewedRequisitions     PurchaseRequisition[] @relation("RequisitionReviewedBy")
  inventoryMovements       InventoryMovement[]
  shiftRotation            EmployeeShiftRotation?
  shiftOverrides           EmployeeShiftOverride[]
  attendanceRecords        AttendanceRecord[]

  // Compensation
  salaryType        SalaryType            @default(MONTHLY)
  salaryAmount      Decimal               @db.Decimal(12, 2)
  paymentMethod     EmployeePaymentMethod @default(BANK_TRANSFER)
  bankName          String?
  bankAccountNumber String?
  mpesaNumber       String?

  // Statutory (Kenya)
  kraPin     String?
  nssfNumber String?
  shaNumber  String?

  // System / till login
  employeeCode String
  pin          String

  // Emergency contact
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeCode])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@index([supervisorId])
  @@index([roleId])
}

// A named work-hours window (e.g. "Day Shift" 06:00-14:00, "Night Shift"
// 22:00-06:00 — endTime earlier than startTime means it crosses midnight).
// Grace minutes give a little slack either side before access is blocked.
// Times are interpreted in Africa/Nairobi local time (this product is
// Kenya-only today, same assumption the tax rules already make).
model ShiftTemplate {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  startTime          String
  endTime            String
  graceMinutesBefore Int      @default(15)
  graceMinutesAfter  Int      @default(15)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rotationSlots RotationSlot[]
  overrides     EmployeeShiftOverride[]

  @@unique([tenantId, name])
}

// An employee's repeating shift pattern — e.g. 7 days on Day Shift then 7
// on Night Shift, repeating forever from anchorDate. One per employee; an
// employee with no rotation at all is unrestricted (no enforcement).
model EmployeeShiftRotation {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String   @unique
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  anchorDate      DateTime @db.Date
  cycleLengthDays Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slots RotationSlot[]
}

// One stretch of a rotation cycle: days [position, position+days) of the
// cycle use this shift. Ordered by `position`; a rotation's slots' `days`
// sum to its cycleLengthDays.
model RotationSlot {
  id              String                @id @default(cuid())
  rotationId      String
  rotation        EmployeeShiftRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  shiftTemplateId String
  shiftTemplate   ShiftTemplate         @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)
  position        Int
  days            Int

  @@index([rotationId])
}

// A one-off exception to an employee's computed rotation for a single date
// — swapping someone's shift for a day without disturbing their ongoing
// pattern. shiftTemplateId null means "unrestricted that day".
model EmployeeShiftOverride {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime       @db.Date
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  reason          String?
  createdAt       DateTime       @default(now())

  @@unique([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

// Daily attendance register — marked manually (there's no clock-in device),
// one row per employee per calendar day. Kept indefinitely; retrieval is
// just a month/year filter, no archiving needed.
model AttendanceRecord {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  notes      String?
  // Plain id, no relation — same convention as PosOrder.createdBy.
  markedBy   String?
  markedAt   DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

model Role {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  isSystemRole    Boolean             @default(false)
  allowedSections PermissionSection[] @default([])
  // Action-level capabilities this role grants, enforced server-side.
  // Empty = none — a role only sees sections via `allowedSections`, it
  // can't yet DO anything gated until explicitly given a permission here.
  permissions     Permission[]        @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  employees       Employee[]

  @@unique([tenantId, name])
}

// Tenant-defined org units an Employee belongs to. Replaced the old fixed
// EmployeeDepartment enum so a business can name its own departments and
// rename them freely — Employee.departmentId keeps pointing at the same row.
model Department {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model BusinessProfile {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl   String?
  shortName String?

  themeBaseColor   String @default("#1c74d1")
  themeAccentColor String @default("#43a047")
  themeFont        String @default("jost")

  businessName       String
  businessType       BusinessType
  currency           Currency
  registrationNumber String?
  kraPin             String?

  // The tenant-wide default a menu item uses when it doesn't set its own.
  // taxRate is the standard rate (0-100); taxMode says whether menu prices
  // already include it; taxTreatment picks Standard / Zero-rated / Exempt.
  taxRate      Decimal      @default(16) @db.Decimal(5, 2)
  taxMode      TaxMode      @default(INCLUSIVE)
  taxTreatment TaxTreatment @default(STANDARD)

  primaryPhone     String?
  alternativePhone String?
  email            String?
  website          String?

  country String?
  county  String?
  city    String?
  address String?

  ownerName  String?
  ownerPhone String?
  ownerEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TANZ staff who sign in to the standalone platform admin app (tenant
// creation, license management). This sits ABOVE every tenant — there's no
// tenantId here — and replaces the old single shared PLATFORM_ADMIN_KEY
// with real per-person email + password accounts. Password is a scrypt
// hash in the same `salt:hash` format as Employee.pin (see lib/hash.ts).
model PlatformAdmin {
  id          String            @id @default(cuid())
  email       String            @unique
  password    String
  name        String
  isActive    Boolean           @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sessions    PlatformSession[]
}

model PlatformSession {
  id        String        @id @default(cuid())
  token     String        @unique
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
}

model ServiceCenterService {
  id              String        @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal       @db.Decimal(12, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model ServiceProvider {
  id           String             @id @default(cuid())
  tenantId     String
  name         String
  specialty    String?
  phone        String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules    ProviderSchedule[]
  appointments Appointment[]

  @@index([tenantId, isActive])
}

model ProviderSchedule {
  id          String          @id @default(cuid())
  tenantId    String
  providerId  String
  startsAt    DateTime
  endsAt      DateTime
  isAvailable Boolean         @default(true)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([tenantId, providerId, startsAt])
}

model MembershipPlan {
  id              String       @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  price           Decimal      @db.Decimal(12, 2)
  durationDays    Int
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     Membership[]

  @@unique([tenantId, name])
}

model Membership {
  id           String              @id @default(cuid())
  tenantId     String
  customerId   String
  planId       String
  startsAt     DateTime
  endsAt       DateTime
  status       MembershipStatus    @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         MembershipPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     MembershipPayment[]
  appointments Appointment[]

  @@index([tenantId, customerId, status])
}

model MembershipPayment {
  id              String        @id @default(cuid())
  tenantId        String
  membershipId    String
  paymentMethodId String
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PAID)
  reference       String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership      Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([tenantId, membershipId, createdAt])
}

model Appointment {
  id              String               @id @default(cuid())
  tenantId        String
  customerId      String
  serviceId       String
  providerId      String
  membershipId    String?
  paymentMethodId String?
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus    @default(BOOKED)
  amount          Decimal              @db.Decimal(12, 2)
  paymentStatus   PaymentStatus        @default(PENDING)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service         ServiceCenterService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider        ServiceProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  membership      Membership?          @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  paymentMethod   PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt, status])
  @@index([tenantId, providerId, startsAt])
}
